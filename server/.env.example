# Application Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL example)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=mobile_project_db

# JWT Secret
JWT_SECRET=supersecretjwtkey_change_me_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Password recovery: one app SMTP sender reaches the allowed PSU recipients.
# Supported recipient domains: email.psu.ac.th and psu.ac.th (independent of Google Login).
# Recipients always use their registered email; never ask for their mailbox password.
# Example sender: Gmail SMTP with an App Password (not your normal password).
# Enable Google 2-Step Verification, then create the App Password:
# https://support.google.com/mail/answer/185833
# Fill these locally in .env. Do not commit .env or put credentials in Flutter.
APP_WEB_URL=http://127.0.0.1:8085
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
